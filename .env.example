# Required: your TorBox API key from https://torbox.app/settings
TORBOX_API_KEY=

# Optional: TorBox API base URL (default: https://api.torbox.app/v1/api)
# TORBOX_API_BASE_URL=https://api.torbox.app/v1/api

# Optional: FUSE mount point (default: /mnt/torbox)
# FUSE_MOUNT_PATH=/mnt/torbox

# Optional: range cache memory budget in MB (default: 256)
# FUSE_CACHE_BUDGET_MB=256

# Optional: prefetch window size in MB (default: 16)
# FUSE_PREFETCH_WINDOW_MB=16

# Optional: max concurrent stream requests per file (default: 2)
# FUSE_STREAM_MAX_INFLIGHT=2

# Optional: max concurrent CDN connections (default: 8)
# FUSE_STREAM_CONCURRENCY=8

# Optional: kernel attribute cache timeout in seconds (default: 1)
# FUSE_ATTR_TIMEOUT_SEC=1

# Optional: kernel directory entry cache timeout in seconds (default: 1)
# FUSE_ENTRY_TIMEOUT_SEC=1

# Optional: catalog refresh interval (default: 3h)
# CATALOG_REFRESH_INTERVAL=3h

# Optional: Prometheus metrics server address (default: 127.0.0.1:9080)
# METRICS_LISTEN_ADDR=127.0.0.1:9080

# Optional: path to the SQLite state database (default: /config/state.db)
# STATE_DB_PATH=/config/state.db

# Optional: log level — debug, info, warn, error (default: info)
# LOG_LEVEL=info